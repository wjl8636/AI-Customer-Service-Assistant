# ============================================================
# 三组上游各自直连,没有网关。三个 KEY 位是独立的,用同一家上游就填同一个值。
# ============================================================

# --- 聊天 ---
# CHAT_MODEL 必须是上游认的真实模型名(没有网关就没有别名这一层,写错会被上游拒)。
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=sk-xxx

# 模型上下文窗口(token)。留空按 CHAT_MODEL 的名字查内置表(app/core/budget.py),
# 表里没有的模型按 32768 保守估。换了表外的模型、或上游调过窗口,就在这里显式填。
# MODEL_CONTEXT_WINDOW=1000000

# 意图识别、摘要默认跟 CHAT 用同一家。想把某个用途单独换到别家(比如摘要走更便宜的模型),
# 才填下面对应的几项;留空就继承 CHAT_* 那组,只用一家上游时一行都不用管。
# INTENT_MODEL=
# INTENT_BASE_URL=
# INTENT_API_KEY=
# SUMMARY_MODEL=
# SUMMARY_BASE_URL=
# SUMMARY_API_KEY=

# --- 思考链 ---
# adaptive(模型自己判断该不该想)/ disabled。别关,关掉结构化输出会大面积拿不到 tool_calls
CHAT_THINKING=adaptive
# 想的强度,不填交给上游默认:low / high / max
# CHAT_REASONING_EFFORT=
# MiniMax 专属。思考进 reasoning_content 独立字段,不开会混在 content 里当 <think> 块吐出来
CHAT_REASONING_SPLIT=true

# --- 嵌入(bge-m3) ---
# BASE_URL 有内置默认值(硅基流动),换上游才需要取消注释
EMBED_API_KEY=sk-xxx
# EMBED_BASE_URL=https://api.siliconflow.cn/v1

# --- 重排(bge-reranker-v2-m3) ---
# 走的是 Jina / Cohere 那套 /rerank 形状,不是 OpenAI 协议
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

TOKEN_BUDGET=2000

# ch02 数据库(复用本机 mewhelp-mysql 容器;全新环境用 docker compose up 起)
# 默认值与下面两行完全一致,不设也能正常工作
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp
# TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp_ch02_test

# ch08 工具系统
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0

# ch09 可观测(Langfuse 自部署;三者齐全才挂回调,缺省时系统照常跑)
# LANGFUSE_PUBLIC_KEY=pk-lf-mewhelp-local
# LANGFUSE_SECRET_KEY=sk-lf-mewhelp-local
# LANGFUSE_BASE_URL=http://localhost:3000
